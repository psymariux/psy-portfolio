# Optional. Server-only token for higher GitHub API limits.
# Prefer a token restricted to public repository reads. Never use NEXT_PUBLIC_GITHUB_TOKEN.
GITHUB_TOKEN=

# Optional private message delivery. Without this, contact returns a truthful unavailable state.
DISCORD_WEBHOOK_URL=

# Set your production origin for Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://psymariux.vercel.app

# Optional online sandbox. TCP/TLS Redis with GET/SET/EVAL/PUBLISH/PSUBSCRIBE.
# Server-only; connect a persistent Redis database to Vercel and map its URI here.
# Never expose the password/URI through a NEXT_PUBLIC_ variable.
REDIS_URL=

# Local development only: run npm run game:dev beside Next.js.
# Production always uses the same-origin /api/game WebSocket endpoint.
# NEXT_PUBLIC_GAME_DEV_WS_URL=ws://127.0.0.1:3102/api/game
# GAME_DEV_PORT=3102
# GAME_DEV_ORIGIN=http://localhost:3000
